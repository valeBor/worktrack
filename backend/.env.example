# =====================================================
# WORKTRACK - VARIABLES DE ENTORNO
# =====================================================
#
# Este archivo contiene ejemplos.
#
# No colocar contraseñas ni secretos reales aquí.
# Los valores reales deben guardarse en:
#
# - backend/.env durante el desarrollo local.
# - Variables del servicio durante el despliegue.
# =====================================================


# =====================================================
# SERVIDOR
# =====================================================

# Desarrollo local:
# NODE_ENV=development
#
# Railway:
# NODE_ENV=production
NODE_ENV=development

# Puerto local.
# Railway proporciona PORT automáticamente.
PORT=3000

# URL canónica del frontend.
#
# También se utiliza para generar los enlaces
# enviados por recuperación de contraseña.
FRONTEND_URL=http://localhost:4200

# Orígenes autorizados por CORS.
#
# Se pueden indicar varios separados por comas:
#
# CORS_ORIGINS=https://frontend.vercel.app,https://www.ejemplo.com
CORS_ORIGINS=http://localhost:4200

# Desarrollo local:
# TRUST_PROXY_HOPS=0
#
# Railway:
# TRUST_PROXY_HOPS=1
TRUST_PROXY_HOPS=0

# Zona horaria utilizada por las reglas del negocio.
APP_TIMEZONE=America/Argentina/Buenos_Aires


# =====================================================
# BASE DE DATOS
# =====================================================

DB_HOST=127.0.0.1

DB_PORT=3306

DB_USER=root

DB_PASSWORD=

DB_NAME=worktrack_flyway

# Cantidad máxima de conexiones del pool.
DB_CONNECTION_LIMIT=10

# Tiempo máximo de espera para conectar,
# expresado en milisegundos.
DB_CONNECT_TIMEOUT_MS=10000


# =====================================================
# JWT DE INICIO DE SESIÓN
# =====================================================

# En producción generar un secreto largo y aleatorio.
JWT_SECRET=GENERAR_SECRETO_ALEATORIO


# =====================================================
# RECUPERACIÓN DE CONTRASEÑA
# =====================================================

# Debe ser diferente de JWT_SECRET.
RESET_TOKEN_SECRET=GENERAR_OTRO_SECRETO_ALEATORIO

RESET_TOKEN_EXPIRES=15m


# =====================================================
# CLOUDFLARE TURNSTILE
# =====================================================

# Clave privada de Turnstile.
#
# La clave pública se configura en Angular.
TURNSTILE_SECRET_KEY=CONFIGURAR_CLAVE_PRIVADA


# =====================================================
# CORREO DE WORKTRACK
# =====================================================

EMAIL_USER=correo_de_soporte@gmail.com

EMAIL_PASS=CONTRASENA_DE_APLICACION

EMAIL_FROM_NAME=Soporte técnico WorkTrack


# =====================================================
# QR DE ASISTENCIA
# =====================================================

# Debe ser diferente de los otros secretos.
QR_TOKEN_SECRET=GENERAR_SECRETO_ALEATORIO_PARA_QR

QR_DURACION_SEGUNDOS=60


# =====================================================
# ARCHIVOS PRIVADOS
# =====================================================

# Desarrollo local:
# FILE_STORAGE_PROVIDER=LOCAL
#
# Producción:
# FILE_STORAGE_PROVIDER=VERCEL_BLOB
FILE_STORAGE_PROVIDER=LOCAL

# Es obligatorio cuando:
# FILE_STORAGE_PROVIDER=VERCEL_BLOB
#
# No colocar el token real en este archivo.
BLOB_READ_WRITE_TOKEN=